<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
   
</head>
<body>
    <h3>All Chats </h3>
   <% for(let chat of chats){ %>
   <div class="Chat">
        <p>From:<%= chat.from %></p>
        <div class="msg">
           <p>msg:<%= chat.msg %></p>
        </div>
          <p>to:<%= chat.to %></p>
          <hr>
    </div>
<% }%>
</body>
</html>

